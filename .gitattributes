# =============================================================================
# BRCloud FluxGate - Normalisation des fins de ligne
# =============================================================================
# Le projet est deploye sur Linux mais peut etre edite depuis Windows.
# Sans cette regle, core.autocrlf=true reecrit les scripts en CRLF et le
# shebang devient "#!/usr/bin/env bash\r" -> "bad interpreter" sur le serveur.
# =============================================================================

# Par defaut : detection auto du texte, toujours checkout en LF
* text=auto eol=lf

# Fichiers executes ou parses sur le serveur : LF obligatoire
*.sh        text eol=lf
*.conf      text eol=lf
*.yaml      text eol=lf
*.yml       text eol=lf
*.socket    text eol=lf
*.service   text eol=lf
*.env       text eol=lf
*.example   text eol=lf

# Binaires
*.png       binary
*.jpg       binary
*.gz        binary
*.tar       binary
